{
  "name": "links",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p . && tsc -p worker",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply links --local",
    "db:migrate:remote": "wrangler d1 migrations apply links --remote",
    "deploy": "vite build && wrangler deploy",
    "build:demo": "vite build --mode demo",
    "dev:demo": "vite --mode demo"
  },
  "dependencies": {
    "hono": "4.13.13",
    "idb-keyval": "6.3.0",
    "minisearch": "7.2.0",
    "solid-js": "1.9.17",
    "tldts": "7.4.19",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.65.0",
    "@cloudflare/workers-types": "5.20261024.1",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vite-plugin-solid": "2.11.14",
    "vitest": "5.0.5",
    "wrangler": "4.152.0"
  }
}